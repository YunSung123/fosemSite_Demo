{{> layout/header}}

<style>
    .index-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 64px 20px 90px;
    }

    .index-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
    }

    .board-list-section {
        margin-top: 42px;
    }

    .board-list-head {
        display: grid;
        grid-template-columns: 100px 1fr 180px;
        padding: 14px 0;
        border-bottom: 1px solid rgba(214, 179, 106, 0.65);
        color: #d6b36a;
        font-size: 14px;
        font-weight: 900;
    }

    .board-row {
        display: grid;
        grid-template-columns: 100px 1fr 180px;
        align-items: center;
        min-height: 64px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.09);
        transition: all 0.16s ease;
    }

    .board-row:hover {
        background: linear-gradient(90deg, rgba(214, 179, 106, 0.08), transparent);
    }

    .board-id {
        color: #7f8896;
        font-weight: 800;
    }

    .board-title-link {
        color: #e9edf3;
        text-decoration: none;
        font-size: 17px;
        font-weight: 800;
    }

    .board-title-link:hover {
        color: #d6b36a;
    }

    .board-writer {
        color: #aeb6c3;
        font-weight: 700;
    }

    .empty-row {
        padding: 60px 0;
        text-align: center;
        color: #7f8896;
        border-bottom: 1px solid rgba(255, 255, 255, 0.09);
        font-weight: 700;
    }

    @media (max-width: 768px) {
        .index-head {
            display: block;
        }

        .index-head .btn-site {
            margin-top: 20px;
        }

        .board-list-head {
            grid-template-columns: 70px 1fr 100px;
        }

        .board-row {
            grid-template-columns: 70px 1fr 100px;
        }
    }
</style>

<main class="index-page">

    <div class="index-head">
        <div>
            <div class="page-category">
                BOARD LIST
            </div>

            <h1 class="page-title">
                최신글
            </h1>

            <p class="page-desc">
                포샘디펜스 공지, 업데이트, 개발 기록을 확인하세요.
            </p>
        </div>

        <a href="/board/save-form" class="btn-site btn-gold">
            글쓰기
        </a>
    </div>

    <section class="board-list-section">

        <div class="board-list-head">
            <div>번호</div>
            <div>제목</div>
            <div>작성자</div>
        </div>

        {{#boardList}}
            <div class="board-row">
                <div class="board-id">{{id}}</div>

                <div>
                    <a href="/board/{{id}}" class="board-title-link">
                        {{title}}
                    </a>
                </div>

                <div class="board-writer">{{user.username}}</div>
            </div>
        {{/boardList}}

        {{^boardList}}
            <div class="empty-row">
                아직 작성된 글이 없습니다.
            </div>
        {{/boardList}}

    </section>

</main>

{{> layout/footer}}