{{> layout/header}}

<style>
    .join-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 64px 20px 90px;
    }

    .join-form {
        padding: 40px 0 56px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .form-block {
        margin-bottom: 28px;
    }

    .form-label-custom {
        display: block;
        margin-bottom: 12px;
        color: #d6b36a;
        font-size: 14px;
        font-weight: 900;
        letter-spacing: 0.5px;
    }

    .form-input-custom {
        width: 100%;
        height: 54px;
        padding: 0 18px;

        border: 1px solid rgba(217, 222, 230, 0.18);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.045);
        color: #f4f7fb;
        font-size: 17px;
        outline: none;

        transition: all 0.18s ease;
    }

    .form-input-custom::placeholder {
        color: #6f7886;
    }

    .form-input-custom:focus {
        border-color: rgba(214, 179, 106, 0.85);
        background: rgba(255, 255, 255, 0.07);
        box-shadow: 0 0 0 3px rgba(214, 179, 106, 0.12);
    }

    .join-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 26px;
    }

    .join-guide {
        margin-top: 18px;
        color: #7f8896;
        font-size: 14px;
        line-height: 1.7;
    }

    .join-guide a {
        color: #d6b36a;
        text-decoration: none;
        font-weight: 800;
    }

    .join-guide a:hover {
        text-decoration: underline;
    }
</style>

<main class="join-page">

    <div class="page-category">
        USER JOIN
    </div>

    <h1 class="page-title">
        회원가입
    </h1>

    <p class="page-desc">
        포샘디펜스 게시판 이용을 위해 계정을 생성합니다.
    </p>

    <form action="/user/join" method="post" class="join-form">

        <div class="form-block">
            <label for="username" class="form-label-custom">아이디</label>
            <input id="username" type="text" name="username" class="form-input-custom" placeholder="아이디를 입력하세요">
        </div>

        <div class="form-block">
            <label for="password" class="form-label-custom">비밀번호</label>
            <input id="password" type="password" name="password" class="form-input-custom" placeholder="비밀번호를 입력하세요">
        </div>

        <div class="form-block">
            <label for="email" class="form-label-custom">이메일</label>
            <input id="email" type="email" name="email" class="form-input-custom" placeholder="이메일을 입력하세요">
        </div>

        <div class="join-actions">
            <a href="/" class="btn-site btn-list">
                메인으로
            </a>

            <button type="submit" class="btn-site btn-gold">
                회원가입
            </button>
        </div>

        <p class="join-guide">
            이미 계정이 있다면
            <a href="/user/login-form">로그인</a>
            화면으로 이동하세요.
        </p>

    </form>

</main>

{{> layout/footer}}