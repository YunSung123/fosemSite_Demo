{{> layout/header}}

<style>
    .login-page {
        max-width: 760px;
        margin: 0 auto;
        padding: 64px 20px 90px;
    }

    .login-form {
        padding: 40px 0 56px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .form-block {
        margin-bottom: 28px;
    }

    .form-label-custom {
        display: block;
        margin-bottom: 12px;
        color: #d6b36a;
        font-size: 14px;
        font-weight: 900;
        letter-spacing: 0.5px;
    }

    .form-input-custom {
        width: 100%;
        height: 54px;
        padding: 0 18px;
        border: 1px solid rgba(217, 222, 230, 0.18);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.045);
        color: #f4f7fb;
        font-size: 17px;
        outline: none;
        transition: all 0.18s ease;
    }

    .form-input-custom::placeholder {
        color: #6f7886;
    }

    .form-input-custom:focus {
        border-color: rgba(214, 179, 106, 0.85);
        background: rgba(255, 255, 255, 0.07);
        box-shadow: 0 0 0 3px rgba(214, 179, 106, 0.12);
    }

    .form-input-custom[readonly] {
        color: #aeb8c7;
        background: rgba(255, 255, 255, 0.025);
        cursor: not-allowed;
    }

    .login-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 26px;
        gap: 12px;
    }

    .login-guide {
        margin-top: 18px;
        color: #7f8896;
        font-size: 14px;
        line-height: 1.7;
    }

    .login-guide strong {
        color: #d6b36a;
    }
</style>

<main class="login-page">

    <div class="page-category">
        USER INFO
    </div>

    <h1 class="page-title">
        회원정보
    </h1>

    <p class="page-desc">
        {{user.username}}님의 회원 정보를 확인하고 수정할 수 있습니다.
    </p>

    <form action="/user/update" method="post" class="login-form">

        <div class="form-block">
            <label for="username" class="form-label-custom">아이디</label>
            <input id="username"
                   type="text"
                   name="username"
                   class="form-input-custom"
                   value="{{user.username}}"
                   readonly>
        </div>

        <div class="form-block">
            <label for="password" class="form-label-custom">비밀번호</label>
            <input id="password"
                   type="password"
                   name="password"
                   class="form-input-custom"
                   placeholder="변경할 비밀번호를 입력하세요">
        </div>

        <div class="form-block">
            <label for="email" class="form-label-custom">이메일</label>
            <input id="email"
                   type="email"
                   name="email"
                   class="form-input-custom"
                   value="{{user.email}}"
                   placeholder="이메일을 입력하세요">
        </div>

        <div class="login-actions">
            <a href="/" class="btn-site btn-list">
                메인으로
            </a>

            <button type="submit" class="btn-site btn-gold">
                회원정보 수정
            </button>
        </div>

        <p class="login-guide">
            아이디는 변경할 수 없습니다. 비밀번호와 이메일만 수정할 수 있습니다.
        </p>

    </form>

</main>

{{> layout/footer}}